{
  "name": "telegram-site-mvp",
  "version": "1.0.0",
  "description": "MVP: Telegram channel posts to database and draft feed",
  "main": "server/server.js",
  "scripts": {
    "db:migrate": "node server/db/migrate.js",
    "dev": "concurrently -n server,client -c blue,green \"npm.cmd run dev:api\" \"npm.cmd run dev:client\"",
    "dev:api": "node --watch server/server.js",
    "dev:client": "npm.cmd --prefix client run dev",
    "dev:web": "npm.cmd run dev:client",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "start": "node server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "grammy": "^1.42.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
